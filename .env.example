# ============================================================
# .env.example — 环境变量模板
# 使用方法：
#   cp .env.example .env
#   然后填入你的真实值
# 注意：.env 已加入 .gitignore，禁止提交到版本控制！
# ============================================================

# ── 数据库 ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=app_user
DB_PASSWORD=change_me_strong_password

# ── Redis ───────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# ── 应用密钥（JWT 签名）────────────────────────────────────
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change_me_use_python_secrets_token_urlsafe
JWT_SECRET_KEY=change_me_use_python_secrets_token_urlsafe

# ── Fernet 加密密钥 ─────────────────────────────────────────
# 生成命令：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change_me_generate_with_fernet

# ── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# ── LLM 服务 ────────────────────────────────────────────────
LLM_URL=http://your-llm-server:port

# ── 短信服务 ────────────────────────────────────────────────
SMS_MESSAGE_URL=http://your-sms-api/sendMsg/batch
SMS_APP_ID=your_app_id
SMS_APP_KEY=your_app_key
SMS_TEMPLATE_1=your_template_id_1
SMS_TEMPLATE_2=your_template_id_2

# ── 文件路径 ────────────────────────────────────────────────
EXCEL_FILE_PATH=./data_resources/
AI_EXCEL_FILE_PATH=./backend/template/AI_result/
REPORT_FILE_PATH=./check_files/
UPLOAD_FOLDER=./backups/
